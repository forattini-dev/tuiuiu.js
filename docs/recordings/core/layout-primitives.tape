# Layout Primitives Demo - Screen, Header, Main, Footer
# Shows the terminal-friendly layout system with 'auto'/'fill' sizing

Output docs/recordings/core/layout-primitives.gif

Set Shell bash
Set FontSize 14
Set Width 800
Set Height 500
Set Padding 20
Set PlaybackSpeed 1
Set TypingSpeed 0

# Hide the setup
Hide
Type "pnpm tsx examples/app-layout.ts"
Enter
Sleep 1s
Show

# Display the layout for a few seconds
Sleep 5s

Hide
Ctrl+C
