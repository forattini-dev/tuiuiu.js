# Tuiuiu Player - Terminal Music Player (Ultra Compact)
# Quick showcase of waveform, playlist, and controls

Output docs/recordings/examples/demo-player.gif

Set Shell bash
Set FontSize 14
Set Width 1400
Set Height 900
Set Padding 20
Set PlaybackSpeed 5.0
Set TypingSpeed 0.001s
Set Framerate 30

# Run the player
Type "pnpm tsx examples/tuiuiu-player.ts"
Enter

# Show waveform animation
Sleep 1s

# Navigate playlist
Down
Sleep 100ms
Down
Sleep 100ms
Enter
Sleep 750ms

# Pause/Play
Type " "
Sleep 250ms
Type " "
Sleep 500ms

# Next track
Type "n"
Sleep 500ms

# Change theme twice
Type "t"
Sleep 400ms
Type "t"
Sleep 400ms

# Volume
Type "+"
Sleep 75ms
Type "+"
Sleep 75ms
Type "+"
Sleep 250ms

# Mute/unmute
Type "m"
Sleep 200ms
Type "m"
Sleep 400ms

# Exit
Type "q"
Sleep 100ms
